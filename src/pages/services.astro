---
import Layout from "../layouts/Layout.astro";
import Img from "../components/Img.astro";
import { site } from "../data/site";

const title =
  "Our Services: Garage, Commercial, Patio & Concrete Coatings | Salt Lake Garage Coatings";
const description =
  "Residential garage coatings, commercial epoxy flooring, patio & walkway coatings, and concrete repair across Salt Lake City, UT. Free estimates — (801) 555-0142.";

const services = [
  {
    id: "residential-garage-coatings",
    name: "Residential Garage Coatings",
    img: "/images/residential-garage.svg",
    lead: "The signature flake-epoxy and polyaspartic floors that make your garage the cleanest room in the house.",
    points: [
      "Full-flake epoxy and polyaspartic hybrid systems in a range of warm, natural color blends.",
      "Diamond-ground preparation with crack and pit repair included on every install.",
      "Slip-resistant texture and a seamless, easy-to-clean surface that resists oil and hot tires.",
      "Most one- and two-car garages completed in a single day.",
    ],
  },
  {
    id: "commercial-epoxy-flooring",
    name: "Commercial Epoxy Flooring",
    img: "/images/commercial-epoxy.svg",
    lead: "Heavy-duty floor systems for showrooms, shops, warehouses, and retail spaces around Salt Lake City.",
    points: [
      "High-build epoxy and urethane topcoats engineered for forklift and foot traffic.",
      "Chemical-, abrasion-, and impact-resistant finishes that simplify cleaning and maintenance.",
      "Line striping, safety markings, and anti-slip aggregate available.",
      "Scheduling around your business hours to minimize downtime.",
    ],
  },
  {
    id: "patio-walkway-coatings",
    name: "Patio & Walkway Coatings",
    img: "/images/patio-coating.svg",
    lead: "Decorative, slip-resistant coatings that bring warmth and durability to outdoor concrete.",
    points: [
      "UV-stable polyaspartic and decorative concrete systems that won&apos;t yellow in the sun.",
      "Textured, slip-resistant finishes ideal for patios, porches, and pool decks.",
      "Natural, earthy color options that complement Utah landscaping.",
      "Seals concrete against moisture, freeze-thaw damage, and staining.",
    ],
  },
  {
    id: "concrete-repair-preparation",
    name: "Concrete Repair & Preparation",
    img: "/images/concrete-repair.svg",
    lead: "The foundation of every lasting coating — proper repair and mechanical surface prep.",
    points: [
      "Diamond grinding and shot-blasting to achieve the correct concrete profile.",
      "Structural repair of cracks, spalling, pitting, and surface damage.",
      "Moisture testing and vapor-barrier priming where slabs need it.",
      "Joint filling and edge detailing for a flawless, fully bonded finish.",
    ],
  },
];
---

<Layout title={title} description={description} path="/services">
  <!-- PAGE HEADER -->
  <section class="border-b border-cream-200 bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">Our Services</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        Premium Floor Coating Services in Salt Lake City
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-soft">
        From a single-car garage to a commercial showroom floor, we install
        durable, beautiful coating systems built for Utah&apos;s climate. Every
        project starts with proper preparation and ends with a written warranty.
      </p>
      <a href={site.phoneHref} class="mt-7 inline-flex items-center gap-2 rounded-full bg-sage-500 px-6 py-3.5 text-base font-semibold text-cream-50 shadow-soft transition-colors hover:bg-sage-600">
        Call for a Free Estimate: {site.phoneDisplay}
      </a>
    </div>
  </section>

  <!-- SERVICE DETAIL BLOCKS -->
  {services.map((s, i) => (
    <section id={s.id} class="scroll-mt-24 border-b border-cream-200">
      <div class={`mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 ${i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}>
        <div>
          <h2 class="text-3xl">{s.name}</h2>
          <p class="mt-4 text-lg leading-relaxed text-stone-soft" set:html={s.lead} />
          <ul class="mt-6 space-y-3">
            {s.points.map((p) => (
              <li class="flex gap-3 text-sm leading-relaxed text-stone-soft">
                <svg viewBox="0 0 24 24" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-sage-500" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span set:html={p} />
              </li>
            ))}
          </ul>
        </div>
        <Img
          src={s.img}
          alt={`${s.name} by Salt Lake Garage Coatings`}
          width={1200}
          height={800}
          class="w-full rounded-3xl object-cover shadow-soft"
        />
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="bg-stone-ink">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl text-cream-50">Not sure which system fits your floor?</h2>
        <p class="mt-2 text-cream-200/80">We&apos;ll walk your space and recommend the right coating — free of charge.</p>
      </div>
      <a href={site.phoneHref} class="inline-flex shrink-0 items-center gap-2 rounded-full bg-sage-400 px-7 py-4 text-base font-semibold text-stone-ink transition-colors hover:bg-sage-300">
        Call {site.phoneDisplay}
      </a>
    </div>
  </section>
</Layout>
