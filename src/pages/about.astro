---
import Layout from "../layouts/Layout.astro";
import Img from "../components/Img.astro";
import { site } from "../data/site";

const title = "About Us | Salt Lake Garage Coatings";
const description =
  "Local Salt Lake City floor coating specialists focused on reliability, premium materials, and craftsmanship built for Utah's climate. Call (801) 555-0142.";

const values = [
  { t: "Reliability", d: "We show up when we say we will, protect your property, and leave the job site spotless. Clear timelines, no surprises." },
  { t: "Local Expertise", d: "We coat floors across the Salt Lake Valley every week. We know exactly how Utah's freeze-thaw cycles and road salt behave on concrete." },
  { t: "Premium Materials", d: "We use professional-grade epoxy and polyaspartic systems, never the thin retail kits sold at big-box stores." },
];
---

<Layout title={title} description={description} path="/about">
  <section class="border-b border-cream-200 bg-cream-100">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2">
      <div class="animate-fade-up">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">About Us</p>
        <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">
          Salt Lake City&apos;s Trusted Floor Coating Crew
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-stone-soft">
          {site.name} is a local team of coating specialists dedicated to one
          thing: installing floors that look stunning and hold up for the long
          haul. We&apos;re built on careful preparation, premium materials, and
          treating every garage like it&apos;s our own.
        </p>
      </div>
      <Img
        src="/images/about-craft.png"
        alt="A local installer applying a premium polyaspartic floor coating"
        width={1200}
        height={900}
        class="w-full rounded-3xl object-cover shadow-soft"
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">Built for Utah, Done Right</h2>
    <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
      <p>
        We started {site.name} because too many homeowners were sold thin,
        peeling coatings that failed after a winter or two. Our approach is the
        opposite: we obsess over surface preparation, use only
        professional-grade products, and stand behind every install. The result
        is a floor that still looks new years after the install.
      </p>
      <p>
        Whether it&apos;s a single-car garage in Sandy, a back patio in Draper,
        or a commercial floor in downtown Salt Lake City, you get the same
        attention to detail, the same clean job site, and the same honest
        guidance about what your concrete actually needs.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3" data-reveal-stagger>
      {values.map((v) => (
        <div class="hover-lift rounded-2xl border border-cream-200 bg-cream-50 p-6">
          <h3 class="text-lg">{v.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-soft">{v.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-stone-ink">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl text-cream-50">Let&apos;s talk about your floor.</h2>
        <p class="mt-2 text-cream-200/80">Serving {site.serviceAreas.join(", ")} and the greater Salt Lake Valley.</p>
      </div>
      <a href={site.phoneHref} class="inline-flex shrink-0 items-center gap-2 rounded-full bg-sage-400 px-7 py-4 text-base font-semibold text-stone-ink transition-colors hover:bg-sage-300">
        Call {site.phoneDisplay}
      </a>
    </div>
  </section>
</Layout>
