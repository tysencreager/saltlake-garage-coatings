---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.jsx";
import { site } from "../data/site";

const title = "Epoxy Garage Floor Cost in Salt Lake City (2026 Guide)";
const description =
  "Real 2026 epoxy & polyaspartic garage floor costs in Salt Lake City: per-sq-ft prices, 2-car totals & what drives them. Free quotes — call (801) 515-4573.";

// 2026 professional installation pricing (national data, consistent with what
// Salt Lake homeowners are quoted). Sources: Angi, HomeGuide, Homewyse 2026.
const systems = [
  {
    name: "Solid-color epoxy",
    price: "$4 – $7 / sq ft",
    twoCar: "$1,800 – $3,500",
    note: "Budget-friendly, deep gloss. Best in low-UV garages; recoat every 5–10 years.",
  },
  {
    name: "Full-flake epoxy",
    price: "$5 – $8 / sq ft",
    twoCar: "$2,200 – $4,000",
    note: "The classic showroom look. Flake hides concrete flaws and adds slip resistance.",
  },
  {
    name: "Epoxy + polyaspartic topcoat (hybrid)",
    price: "$6 – $10 / sq ft",
    twoCar: "$2,800 – $5,000",
    note: "Epoxy base for build and adhesion, UV-stable polyaspartic clear coat on top. Our most popular system.",
  },
  {
    name: "Full polyaspartic",
    price: "$8 – $12 / sq ft",
    twoCar: "$3,500 – $6,000",
    note: "Fastest cure (often 1-day install), 100% UV-stable, handles Utah temperature swings. Longest lifespan.",
  },
];

const garageSizes = [
  { size: "1-car garage", sqft: "~200 – 280 sq ft", range: "$1,200 – $2,800" },
  { size: "2-car garage", sqft: "~400 – 520 sq ft", range: "$2,000 – $5,400" },
  { size: "3-car garage", sqft: "~600 – 750 sq ft", range: "$3,000 – $7,500" },
];

const costFactors = [
  {
    title: "Concrete condition & repair",
    body: "Salt Lake's freeze-thaw cycles are brutal on slabs. Filling cracks, repairing spalled or pitted areas, and grinding uneven spots adds labor before any coating goes down. A slab in good shape keeps you at the low end of the range; heavy repair work can add several hundred dollars.",
  },
  {
    title: "Surface preparation",
    body: "Diamond grinding the slab to a proper profile is non-negotiable for a coating that lasts — labor (mostly prep) is typically a third to half of the total price. Quotes that skip prep are the ones that peel a year later.",
  },
  {
    title: "Moisture in the slab",
    body: "Snowmelt and a high water table can push moisture vapor up through concrete. If a moisture test calls for a vapor-barrier primer, expect a modest add — far cheaper than a delaminated floor.",
  },
  {
    title: "System & topcoat choice",
    body: "Epoxy-only is the budget path; a polyaspartic topcoat or full polyaspartic system costs more up front but is UV-stable, cures fast, and typically lasts 15–20 years versus 5–10 for basic epoxy.",
  },
];

const faqs = [
  {
    q: "How much does an epoxy garage floor cost in Salt Lake City?",
    a: "Professionally installed epoxy runs about $4–$8 per square foot in the Salt Lake area in 2026, and polyaspartic systems run $8–$12. For a standard 2-car garage (400–520 sq ft), most homeowners pay $2,000–$5,400 installed, depending on concrete condition and the system chosen.",
  },
  {
    q: "How much does it cost to coat a 2-car garage floor?",
    a: "A typical 2-car garage in the Salt Lake Valley is 400–520 square feet. Expect roughly $2,200–$4,000 for a full-flake epoxy system and $2,800–$6,000 for a polyaspartic or hybrid system, including surface prep and minor crack repair.",
  },
  {
    q: "Is polyaspartic worth the extra cost in Utah?",
    a: "Usually, yes. Polyaspartic is 100% UV-stable (no yellowing), cures in hours instead of days, stays flexible through Utah's temperature swings, and typically lasts 15–20 years versus 5–10 for standard epoxy. On a cost-per-year basis it's often the cheaper floor.",
  },
  {
    q: "Why do garage floor coating quotes vary so much?",
    a: "The big variables are concrete condition (crack and spall repair), how much grinding the slab needs, moisture mitigation, and the coating system itself. Two quotes for the 'same' garage can differ by thousands if one skips proper prep — which is also why the cheap quote often fails first.",
  },
  {
    q: "Can't I just use a DIY epoxy kit?",
    a: "Big-box DIY kits cost $100–$300, but they're thin water-based coatings applied over minimally prepped concrete. In Utah garages they commonly fail from hot-tire pickup and road-salt exposure within a couple of years. A professional system is thicker, mechanically bonded to ground concrete, and warrantied.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={title} description={description} path="/epoxy-garage-floor-cost">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- PAGE HEADER -->
  <section class="border-b border-cream-200 bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 animate-fade-up">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">
        2026 Pricing Guide
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        Epoxy Garage Floor Cost in Salt Lake City
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-soft">
        Straight answers on what a coated garage floor actually costs in the
        Salt Lake Valley in 2026 — per square foot, by garage size, and what
        makes the price move. No hidden-fee games.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={site.phoneHref}
          class="inline-flex items-center gap-2 rounded-full bg-sage-500 px-6 py-3.5 text-base font-semibold text-cream-50 shadow-soft transition-colors hover:bg-sage-600"
        >
          Call for a Quote: {site.phoneDisplay}
        </a>
        <a
          href="#quote"
          class="inline-flex items-center gap-2 rounded-full bg-cream-50 px-6 py-3.5 text-base font-semibold text-stone-ink shadow-soft transition-colors hover:bg-cream-100"
        >
          Get My Price
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK ANSWER -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">The Short Answer</h2>
    <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
      <p>
        In 2026, professionally installed <strong>epoxy garage floors in Salt
        Lake City run about $4–$8 per square foot</strong>, and premium
        <strong>polyaspartic systems run $8–$12 per square foot</strong>. For a
        standard 2-car garage, that works out to roughly
        <strong>$2,000–$5,400 installed</strong>, including surface grinding and
        minor crack repair. Where you land in that range comes down to the
        condition of your concrete and the system you choose.
      </p>
      <p>
        Those figures line up with national 2026 cost data from Angi, HomeGuide,
        and Homewyse — and with what we see quoted across the Salt Lake Valley.
        Below is the full breakdown so you can sanity-check any bid you get,
        including ours.
      </p>
    </div>
  </section>

  <!-- COST BY SYSTEM -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl">Cost by Coating System</h2>
        <p class="mt-3 text-base leading-relaxed text-stone-soft">
          Installed prices — materials, prep, and labor. 2-car totals assume
          400–520 sq ft.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
        {systems.map((s) => (
          <div class="hover-lift rounded-2xl border border-cream-200 bg-cream-50 p-6">
            <h3 class="text-lg">{s.name}</h3>
            <p class="mt-2 font-display text-2xl font-semibold text-sage-600">{s.price}</p>
            <p class="mt-1 text-sm font-medium text-stone-ink">2-car garage: {s.twoCar}</p>
            <p class="mt-2.5 text-sm leading-relaxed text-stone-soft">{s.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COST BY GARAGE SIZE -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">Cost by Garage Size</h2>
    <p class="mt-3 text-base leading-relaxed text-stone-soft">
      Typical installed totals for Salt Lake Valley homes, across epoxy and
      polyaspartic systems:
    </p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[28rem] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b-2 border-sand-300 text-xs font-semibold uppercase tracking-[0.12em] text-sage-600">
            <th scope="col" class="py-3 pr-4">Garage</th>
            <th scope="col" class="py-3 pr-4">Typical Size</th>
            <th scope="col" class="py-3">Installed Cost</th>
          </tr>
        </thead>
        <tbody class="text-stone-soft">
          {garageSizes.map((g) => (
            <tr class="border-b border-cream-200">
              <td class="py-3.5 pr-4 font-medium text-stone-ink">{g.size}</td>
              <td class="py-3.5 pr-4">{g.sqft}</td>
              <td class="py-3.5 font-semibold text-stone-ink">{g.range}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-stone-soft">
      Coating extra spaces at the same time — a shop bay, basement, or
      <a href="/services#patio-walkway-coatings" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">patio</a>
      — usually lowers the per-square-foot price, since mobilization and setup
      are already covered.
    </p>
  </section>

  <!-- WHAT MOVES THE PRICE -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl">What Moves the Price in Utah</h2>
        <p class="mt-3 text-base leading-relaxed text-stone-soft">
          Four things explain almost every difference between a $2,000 quote and
          a $5,000 one.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
        {costFactors.map((f) => (
          <div class="hover-lift rounded-2xl border border-cream-200 bg-cream-50 p-6">
            <h3 class="text-lg">{f.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-stone-soft">{f.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 max-w-2xl text-base leading-relaxed text-stone-soft" data-reveal>
        Slab in rough shape? Our
        <a href="/services#concrete-repair-preparation" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">concrete repair and preparation work</a>
        is built into every quote, so the number you're given is the number you pay.
      </p>
    </div>
  </section>

  <!-- LONG-TERM VALUE -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">Cheap Now vs. Cheap Over 20 Years</h2>
    <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
      <p>
        The lowest bid is rarely the cheapest floor. A basic epoxy job at
        $1,500–$2,000 that needs recoating every 5–7 years costs more per year
        of service than a $3,000–$4,000 polyaspartic or hybrid system that runs
        15–20 years — especially in Salt Lake, where road salt, snowmelt brine,
        and hot-tire pickup destroy thin coatings fast.
      </p>
      <p>
        That's why our default recommendation for most Utah garages is the
        <a href="/services#residential-garage-coatings" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">epoxy + polyaspartic hybrid system</a>:
        epoxy where it's strongest (build and adhesion), polyaspartic where it's
        strongest (UV stability, abrasion resistance, fast cure). You can read
        more about how the two chemistries compare on our
        <a href="/" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">home page</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-3xl" data-reveal>Garage Floor Cost FAQs</h2>
      <div class="mt-8 space-y-4" data-reveal-stagger>
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-cream-200 bg-cream-50 p-6">
            <summary class="cursor-pointer list-none font-display text-lg font-semibold text-stone-ink marker:content-none">
              {f.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-soft">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section id="quote" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-2" data-reveal>
      <div>
        <h2 class="text-3xl">Get Your Exact Price</h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-stone-soft">
          Ranges are useful; a real number is better. Tell us about your garage
          and we'll call you back the same day with a firm quote — or call
          <a href={site.phoneHref} class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">{site.phoneDisplay}</a>
          now. You can also reach us through our
          <a href="/contact" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">contact page</a>.
        </p>
      </div>
      <div class="rounded-3xl border border-cream-200/80 bg-cream-50 p-6 shadow-soft sm:p-8">
        <LeadForm client:load phoneDisplay={site.phoneDisplay} phoneHref={site.phoneHref} compact={true} />
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-stone-ink">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl text-cream-50">Ready for a number, not a range?</h2>
        <p class="mt-2 text-cream-200/80">Free quotes across Salt Lake City and the surrounding valley.</p>
      </div>
      <a href={site.phoneHref} class="inline-flex shrink-0 items-center gap-2 rounded-full bg-sage-400 px-7 py-4 text-base font-semibold text-stone-ink transition-colors hover:bg-sage-300">
        Call {site.phoneDisplay}
      </a>
    </div>
  </section>
</Layout>
