---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.jsx";
import { site } from "../data/site";

const title = "Epoxy vs. Polyaspartic Garage Floors in Utah (2026)";
const description =
  "Epoxy or polyaspartic for a Utah garage? Compare cure time, UV yellowing, winter installs & 2026 cost. Get a free Salt Lake City quote: (801) 515-4573.";

// Head-to-head rows. Figures consistent with our 2026 cost guide
// (/epoxy-garage-floor-cost) and national 2026 data (Angi, HomeGuide).
const compareRows = [
  {
    label: "Installed cost (2026)",
    epoxy: "$4 – $8 / sq ft",
    poly: "$8 – $12 / sq ft",
  },
  {
    label: "Walk on it",
    epoxy: "24 – 72 hours",
    poly: "4 – 6 hours",
  },
  {
    label: "Park on it",
    epoxy: "3 – 7 days",
    poly: "≈ 24 hours",
  },
  {
    label: "UV resistance",
    epoxy: "Yellows in sunlight, often within 12–18 months",
    poly: "100% UV-stable — no yellowing",
  },
  {
    label: "Install temperature",
    epoxy: "Needs ~50°F+ slab & air, through full cure",
    poly: "Cold-rated formulas apply well below freezing",
  },
  {
    label: "Typical lifespan",
    epoxy: "5 – 10 years",
    poly: "15 – 20 years",
  },
  {
    label: "Flexibility",
    epoxy: "Rigid — can crack as the slab moves",
    poly: "Stays flexible through freeze-thaw movement",
  },
];

const utahFactors = [
  {
    title: "High-altitude UV",
    body: "Salt Lake sits at ~4,300 feet, and UV gets stronger with elevation. Sunlight through a south- or west-facing garage door yellows standard epoxy fast — often within a year or two. Polyaspartic is 100% UV-stable and keeps its color for the life of the floor.",
  },
  {
    title: "Freeze-thaw slab movement",
    body: "Wasatch Front slabs expand and contract through our winter freeze-thaw cycles. Rigid epoxy films can crack along with the concrete; polyaspartic stays flexible through temperature swings, so the coating moves with the slab instead of fighting it.",
  },
  {
    title: "Road salt & snowmelt brine",
    body: "Every winter your tires carry magnesium-chloride brine off I-15 and drop it on the garage floor. Both systems seal the slab, but polyaspartic's denser, chemical-resistant surface shrugs off salt exposure that softens and dulls cheaper coatings.",
  },
  {
    title: "Short install windows",
    body: "Standard epoxy needs the slab and air at roughly 50°F or warmer for the entire multi-day cure — a tall order in a Utah garage from November to March. Cold-rated polyaspartic installs year-round, and you're parking on it the next day instead of a week later.",
  },
];

const faqs = [
  {
    q: "Which is better for a Utah garage: epoxy or polyaspartic?",
    a: "For most Utah garages, polyaspartic (or an epoxy base with a polyaspartic topcoat) wins. It's 100% UV-stable at our high-altitude sunlight, stays flexible through freeze-thaw slab movement, resists road-salt brine, and cures in hours instead of days. Epoxy still makes sense when upfront budget is the priority and the garage gets little direct sun.",
  },
  {
    q: "Is polyaspartic worth the extra cost over epoxy?",
    a: "Usually. Polyaspartic runs $8–$12 per square foot versus $4–$8 for epoxy in 2026, but it typically lasts 15–20 years versus 5–10. On a cost-per-year basis the premium system is often the cheaper floor — especially in Utah, where UV and salt shorten an epoxy floor's life.",
  },
  {
    q: "How long before I can park on each coating?",
    a: "Polyaspartic takes foot traffic in about 4–6 hours and vehicles in roughly 24 hours — most installs are one day. Standard epoxy needs 24–72 hours before foot traffic and up to 7 days before you should park on it.",
  },
  {
    q: "Can garage floor coatings be installed in a Utah winter?",
    a: "Polyaspartic, yes — cold-rated formulations apply in temperatures far below what epoxy tolerates, so we install through the winter. Standard epoxy needs the slab and air around 50°F or warmer for the full cure period, which usually means waiting for warm weather or heating the garage for days.",
  },
  {
    q: "What is a hybrid epoxy + polyaspartic system?",
    a: "An epoxy base coat for build and adhesion, topped with a UV-stable polyaspartic clear coat. At $6–$10 per square foot it splits the difference on price while fixing epoxy's two big Utah weaknesses — yellowing and salt wear — which is why it's our most popular system.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={title} description={description} path="/epoxy-vs-polyaspartic">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- PAGE HEADER -->
  <section class="border-b border-cream-200 bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 animate-fade-up">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">
        2026 Comparison Guide
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        Epoxy vs. Polyaspartic: Which Garage Floor Coating Is Right for Utah?
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-soft">
        The honest head-to-head for Salt Lake homeowners — cure times, UV
        yellowing, winter installs, road salt, and what each system really
        costs in 2026.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={site.phoneHref}
          class="inline-flex items-center gap-2 rounded-full bg-sage-500 px-6 py-3.5 text-base font-semibold text-cream-50 shadow-soft transition-colors hover:bg-sage-600"
        >
          Call for a Quote: {site.phoneDisplay}
        </a>
        <a
          href="#quote"
          class="inline-flex items-center gap-2 rounded-full bg-cream-50 px-6 py-3.5 text-base font-semibold text-stone-ink shadow-soft transition-colors hover:bg-cream-100"
        >
          Get My Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK ANSWER -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">The Short Answer</h2>
    <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
      <p>
        <strong>For most Utah garages, polyaspartic — or an epoxy base with a
        polyaspartic topcoat — is the better floor.</strong> It's 100% UV-stable
        under our high-altitude sun, stays flexible through Wasatch Front
        freeze-thaw cycles, shrugs off winter road-salt brine, and cures in
        hours instead of days. Epoxy's advantage is price: at
        <strong>$4–$8 per square foot versus $8–$12 for polyaspartic</strong>,
        it's the budget pick for garages that see little direct sunlight.
      </p>
      <p>
        The catch: an epoxy floor typically lasts 5–10 years in Utah conditions
        while a polyaspartic floor runs 15–20, so the cheaper floor per year of
        service is usually the premium one. Full installed pricing for every
        system is in our
        <a href="/epoxy-garage-floor-cost" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">2026 garage floor cost guide</a>.
      </p>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl">Epoxy vs. Polyaspartic at a Glance</h2>
        <p class="mt-3 text-base leading-relaxed text-stone-soft">
          Professionally installed systems, 2026 figures. DIY kits are a
          different (shorter-lived) story — see our
          <a href="/diy-epoxy-garage-floor" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">DIY epoxy guide</a>.
        </p>
      </div>
      <div class="mt-8 overflow-x-auto" data-reveal>
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b-2 border-sand-300 text-xs font-semibold uppercase tracking-[0.12em] text-sage-600">
              <th scope="col" class="py-3 pr-4"></th>
              <th scope="col" class="py-3 pr-4">Epoxy</th>
              <th scope="col" class="py-3">Polyaspartic</th>
            </tr>
          </thead>
          <tbody class="text-stone-soft">
            {compareRows.map((r) => (
              <tr class="border-b border-cream-200 bg-cream-50/50">
                <th scope="row" class="py-3.5 pr-4 align-top font-medium text-stone-ink">{r.label}</th>
                <td class="py-3.5 pr-4 align-top">{r.epoxy}</td>
                <td class="py-3.5 align-top font-medium text-stone-ink">{r.poly}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS MORE IN UTAH -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-3xl">Why the Choice Matters More in Utah</h2>
      <p class="mt-3 text-base leading-relaxed text-stone-soft">
        A coating that performs fine in a mild climate gets tested hard on the
        Wasatch Front. Four local realities drive our recommendation:
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
      {utahFactors.map((f) => (
        <div class="hover-lift rounded-2xl border border-cream-200 bg-cream-50 p-6">
          <h3 class="text-lg">{f.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-stone-soft">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHEN EPOXY / WHEN POLY -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6" data-reveal>
      <h2 class="text-3xl">When Each System Wins</h2>
      <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
        <p>
          <strong>Choose epoxy</strong> when upfront budget is the deciding
          factor, the garage faces north or stays shaded, and you can give the
          floor a warm-weather week to cure. A full-flake epoxy floor is still a
          huge upgrade over bare, dusting concrete.
        </p>
        <p>
          <strong>Choose polyaspartic</strong> when you want the floor done in a
          day, installed in any season, and looking the same in year fifteen as
          it did on day one — especially with a sun-facing door or a driveway
          that carries salt in all winter.
        </p>
        <p>
          <strong>Or split the difference.</strong> Our most popular install is
          the hybrid from our
          <a href="/services#residential-garage-coatings" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">residential garage coating service</a>:
          an epoxy base for build and adhesion under a UV-stable polyaspartic
          clear coat, at $6–$10 per square foot. Epoxy where it's strongest,
          polyaspartic where Utah is toughest.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl" data-reveal>Epoxy vs. Polyaspartic FAQs</h2>
    <div class="mt-8 space-y-4" data-reveal-stagger>
      {faqs.map((f) => (
        <details class="group rounded-2xl border border-cream-200 bg-cream-50 p-6">
          <summary class="cursor-pointer list-none font-display text-lg font-semibold text-stone-ink marker:content-none">
            {f.q}
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-stone-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section id="quote" class="bg-cream-100 py-16">
    <div class="mx-auto max-w-6xl scroll-mt-24 px-4 sm:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-2" data-reveal>
        <div>
          <h2 class="text-3xl">Not Sure Which System Fits Your Garage?</h2>
          <p class="mt-3 max-w-xl text-base leading-relaxed text-stone-soft">
            Tell us about your garage and we'll recommend the right system for
            your slab, sun exposure, and budget — with a firm quote, not a
            range. Or call
            <a href={site.phoneHref} class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">{site.phoneDisplay}</a>
            and ask. You can also reach us through our
            <a href="/contact" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">contact page</a>.
          </p>
        </div>
        <div class="rounded-3xl border border-cream-200/80 bg-cream-50 p-6 shadow-soft sm:p-8">
          <LeadForm client:load phoneDisplay={site.phoneDisplay} phoneHref={site.phoneHref} compact={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-stone-ink">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl text-cream-50">Get the right floor the first time.</h2>
        <p class="mt-2 text-cream-200/80">Free quotes across Salt Lake City and the surrounding valley.</p>
      </div>
      <a href={site.phoneHref} class="inline-flex shrink-0 items-center gap-2 rounded-full bg-sage-400 px-7 py-4 text-base font-semibold text-stone-ink transition-colors hover:bg-sage-300">
        Call {site.phoneDisplay}
      </a>
    </div>
  </section>
</Layout>
