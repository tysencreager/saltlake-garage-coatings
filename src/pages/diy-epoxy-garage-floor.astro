---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.jsx";
import { site } from "../data/site";

const title = "DIY Epoxy Garage Floor in Utah: Costs & Pitfalls (2026)";
const description =
  "DIY epoxy garage floor? Real 2026 kit costs, prep steps & why hot tires peel cheap coatings. Free Salt Lake City quote: (801) 515-4573.";

// Real 2026 DIY line items. Kit pricing from big-box retail (Rust-Oleum
// EpoxyShield 2.5-car kit ~$130–$185 at Walmart/Home Depot); grinder rental
// from Home Depot Tool Rental ($80–$160/day); pro figures match our cost guide.
const diyCosts = [
  {
    item: "Big-box epoxy kit (2.5-car, water-based)",
    cost: "$130 – $185",
    note: "Rust-Oleum EpoxyShield-class kits: ~40–50% solids, one thin 3–4 mil coat",
  },
  {
    item: "Premium 100%-solids DIY kit (2-car)",
    cost: "$400 – $800",
    note: "Closer to pro-grade material — but the prep problem remains yours",
  },
  {
    item: "Walk-behind concrete grinder rental",
    cost: "$80 – $160 / day",
    note: "The prep step most DIY floors skip — acid etch alone is not enough",
  },
  {
    item: "Degreaser, crack filler, etch, tools",
    cost: "$50 – $150",
    note: "Cleaner, filler, rollers, spiked shoes, moisture-test supplies",
  },
  {
    item: "Realistic DIY total (2-car garage)",
    cost: "$260 – $1,100",
    note: "Plus 2–3 full days of labor and a 3–7 day cure before parking",
  },
  {
    item: "Professional system, installed",
    cost: "$4 – $12 / sq ft",
    note: "Epoxy $4–$8, hybrid $6–$10, polyaspartic $8–$12 — ground, repaired, warrantied",
  },
];

const prepSteps = [
  {
    title: "1. Degrease and clean the slab",
    body: "Oil spots wick into concrete and reject coatings. Scrub with a concrete degreaser until water no longer beads on old drip spots — any spot that still beads will be the first place the coating lets go.",
  },
  {
    title: "2. Repair cracks, pits, and spalling",
    body: "Wasatch Front slabs move with freeze-thaw cycles, and coatings telegraph every unrepaired crack. Fill cracks and spalled areas with a polymer-modified patch and let it cure fully before coating.",
  },
  {
    title: "3. Grind — don't just acid-etch",
    body: "Kits ship a citric-acid etch packet because it's cheap to include, but etching only opens the surface; it can't remove curing sealers or laitance. Diamond grinding (rentable at ~$80–$160/day) profiles the slab so the epoxy keys into the concrete instead of sitting on top.",
  },
  {
    title: "4. Test for moisture",
    body: "Tape a 2'×2' plastic sheet to the slab for 24 hours. Condensation or a dark spot underneath means moisture vapor is pushing up through the concrete — the #1 cause of sheet peeling. Utah's snowmelt season is exactly when marginal slabs fail this test.",
  },
  {
    title: "5. Watch the temperature window",
    body: "Standard epoxy wants the slab and air at roughly 50°F or warmer through the full cure. In an unheated Utah garage that limits DIY installs to roughly April–October — coat a cold slab and it may never reach full hardness.",
  },
];

const failureModes = [
  {
    title: "Hot tire pickup",
    body: "Tires come off I-15 at over 140°F in summer. Thin water-based kit coatings soften under that heat, grip the rubber, and peel off in tire-shaped patches as the tire cools and contracts. It's the single most common DIY failure — and it shows up the first hot week after the install.",
  },
  {
    title: "Thin, low-solids film",
    body: "Big-box kits are roughly 40–50% solids, so half the wet coat evaporates, leaving a 3–4 mil paint-thin film. Professional builds run 100%-solids epoxy at several times that thickness, which is why one survives snow-blower skids and jack stands and the other doesn't.",
  },
  {
    title: "Moisture vapor from below",
    body: "Coat over a slab that fails the plastic-sheet test and vapor pressure will blister and delaminate the floor from underneath. Pros measure moisture first and use vapor-barrier primers when a slab needs one; kits don't mention it on the box.",
  },
  {
    title: "Utah sun and road salt",
    body: "At Salt Lake's ~4,300-foot elevation, UV through a south-facing door yellows bare epoxy — often within 12–18 months — and magnesium-chloride brine dulls and softens cheap topcoats every winter. Kits rarely include the UV-stable clear coat that handles either.",
  },
];

const faqs = [
  {
    q: "How much does a DIY epoxy garage floor cost in 2026?",
    a: "A big-box water-based kit for a 2 to 2.5-car garage runs $130–$185, but a realistic DIY budget is $260–$1,100 once you add a grinder rental ($80–$160/day), degreaser, crack filler, and tools — or a premium 100%-solids kit at $400–$800. A professionally installed system runs $4–$12 per square foot with prep, repairs, and a warranty included.",
  },
  {
    q: "Why do DIY epoxy garage floors peel?",
    a: "The usual causes are hot tire pickup (thin water-based coatings soften under 140°F+ summer tires and peel as they cool), skipped grinding so the coating never bonded into the slab, and moisture vapor pushing up through the concrete. All three trace back to prep and film thickness, not bad luck.",
  },
  {
    q: "What is hot tire pickup?",
    a: "Driving heats tires well past 140°F. Parked on a thin or poorly bonded coating, that heat softens the film, the cooling tire contracts and grips it, and the coating peels up in tire-shaped patches. Thick 100%-solids systems over ground concrete resist it; 3–4 mil water-based kit films frequently don't.",
  },
  {
    q: "Do I need to grind my garage floor before epoxy, or is acid etching enough?",
    a: "Grind if you want the floor to last. The acid-etch packet included with kits opens the surface slightly but can't remove curing compounds, sealers, or weak surface laitance — and coatings applied over them fail early. A rented walk-behind grinder ($80–$160/day) or a pro's dust-controlled diamond grind gives the mechanical profile epoxy needs.",
  },
  {
    q: "Is a DIY epoxy kit worth it for a Utah garage?",
    a: "For a low-traffic shop or a short-term refresh on a sound, dry slab — maybe. For a daily-driver garage in Utah, the combination of hot summers, high-altitude UV, winter road-salt brine, and freeze-thaw slab movement kills most kit floors in 1–3 years. A warrantied professional system typically lasts 15–20 years, so the cost per year usually favors the pro install.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={title} description={description} path="/diy-epoxy-garage-floor">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- PAGE HEADER -->
  <section class="border-b border-cream-200 bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 animate-fade-up">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">
        2026 DIY Guide
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        DIY Epoxy Garage Floors in Utah: What Kits Really Cost — and Where They Fail
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-soft">
        The honest guide for Salt Lake homeowners: real 2026 kit and rental
        prices, the prep steps that decide everything, and why hot tires peel
        so many kit floors by their second summer.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={site.phoneHref}
          class="inline-flex items-center gap-2 rounded-full bg-sage-500 px-6 py-3.5 text-base font-semibold text-cream-50 shadow-soft transition-colors hover:bg-sage-600"
        >
          Call for a Quote: {site.phoneDisplay}
        </a>
        <a
          href="#quote"
          class="inline-flex items-center gap-2 rounded-full bg-cream-50 px-6 py-3.5 text-base font-semibold text-stone-ink shadow-soft transition-colors hover:bg-cream-100"
        >
          Get My Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK ANSWER -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">The Short Answer</h2>
    <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
      <p>
        <strong>You can epoxy a garage floor yourself for a few hundred
        dollars — the catch is how long it lasts.</strong> A big-box kit costs
        $130–$185 and a realistic all-in DIY budget is $260–$1,100 for a 2-car
        garage. But those kits are thin, roughly 40–50%-solids water-based
        coatings, and in a Utah garage — hot summer tires, high-altitude sun,
        winter road-salt brine — most fail within 1–3 years, usually starting
        with tire-shaped peeling where you park.
      </p>
      <p>
        A professional floor runs
        <strong>$4–$12 per square foot installed</strong> depending on the
        system (full pricing in our
        <a href="/epoxy-garage-floor-cost" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">2026 cost guide</a>)
        and typically lasts 15–20 years, because the material is 100%-solids
        and the slab is diamond-ground, repaired, and moisture-checked first.
        If you do go DIY, the prep steps below are what separate a floor that
        holds from one that peels.
      </p>
    </div>
  </section>

  <!-- COST TABLE -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl">DIY Epoxy Costs vs. Professional (2026)</h2>
        <p class="mt-3 text-base leading-relaxed text-stone-soft">
          Current big-box retail and Home Depot Tool Rental figures. Pro
          pricing matches our installed-cost guide.
        </p>
      </div>
      <div class="mt-8 overflow-x-auto" data-reveal>
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b-2 border-sand-300 text-xs font-semibold uppercase tracking-[0.12em] text-sage-600">
              <th scope="col" class="py-3 pr-4">Line item</th>
              <th scope="col" class="py-3 pr-4">2026 cost</th>
              <th scope="col" class="py-3">Notes</th>
            </tr>
          </thead>
          <tbody class="text-stone-soft">
            {diyCosts.map((r) => (
              <tr class="border-b border-cream-200 bg-cream-50/50">
                <th scope="row" class="py-3.5 pr-4 align-top font-medium text-stone-ink">{r.item}</th>
                <td class="py-3.5 pr-4 align-top whitespace-nowrap">{r.cost}</td>
                <td class="py-3.5 align-top">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- PREP STEPS -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-3xl">How to Prep a Garage Floor for Epoxy</h2>
      <p class="mt-3 text-base leading-relaxed text-stone-soft">
        Prep is 80% of the job. Every failure mode on this page traces back to
        one of these five steps being skipped or rushed:
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
      {prepSteps.map((s) => (
        <div class="hover-lift rounded-2xl border border-cream-200 bg-cream-50 p-6">
          <h3 class="text-lg">{s.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-stone-soft">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY DIY FLOORS FAIL -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl">Why DIY Epoxy Floors Peel in Utah</h2>
        <p class="mt-3 text-base leading-relaxed text-stone-soft">
          Four failure modes account for nearly every peeling kit floor we're
          called to fix — and Utah's climate accelerates all of them:
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
        {failureModes.map((f) => (
          <div class="hover-lift rounded-2xl border border-cream-200 bg-cream-50 p-6">
            <h3 class="text-lg">{f.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-stone-soft">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DIY VS PRO VERDICT -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" data-reveal>
    <h2 class="text-3xl">When DIY Makes Sense — and When It Doesn't</h2>
    <div class="mt-5 space-y-5 text-base leading-relaxed text-stone-soft">
      <p>
        <strong>DIY is a reasonable bet</strong> for a low-traffic shop,
        basement, or storage bay on a sound, dry slab — somewhere hot tires,
        salt, and sun never touch. Grind, patch, moisture-test, and use a
        premium 100%-solids kit, and you can get a serviceable floor for under
        a grand.
      </p>
      <p>
        <strong>For the garage you park in every day, the math flips.</strong>
        A kit floor that peels in year two costs more per year than a
        professional system that lasts fifteen or twenty — before counting the
        weekend spent grinding and the second weekend spent stripping the
        failed coat. Our
        <a href="/services#residential-garage-coatings" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">residential installs</a>
        pair a 100%-solids epoxy base with a UV-stable
        <a href="/epoxy-vs-polyaspartic" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">polyaspartic topcoat</a>
        precisely because that combination handles hot tire pickup, altitude
        UV, and mag-chloride brine — the three things Utah throws at a garage
        floor.
      </p>
      <p>
        Not sure your slab is a good coating candidate at all? Send a photo
        through the <a href="/contact" class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">contact page</a>
        or call <a href={site.phoneHref} class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">{site.phoneDisplay}</a> —
        we'll tell you straight, including when a DIY kit is honestly all you
        need.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-3xl" data-reveal>DIY Epoxy Garage Floor FAQs</h2>
      <div class="mt-8 space-y-4" data-reveal-stagger>
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-cream-200 bg-cream-50 p-6">
            <summary class="cursor-pointer list-none font-display text-lg font-semibold text-stone-ink marker:content-none">
              {f.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-soft">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section id="quote" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-2" data-reveal>
      <div>
        <h2 class="text-3xl">Get a Firm Quote Before You Rent a Grinder</h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-stone-soft">
          It costs nothing to compare. Tell us about your garage and we'll
          quote a warrantied, one-day install — then decide whether the DIY
          weekend is still worth it. Or call
          <a href={site.phoneHref} class="font-medium text-sage-600 underline underline-offset-2 hover:text-sage-500">{site.phoneDisplay}</a>.
        </p>
      </div>
      <div class="rounded-3xl border border-cream-200/80 bg-cream-50 p-6 shadow-soft sm:p-8">
        <LeadForm client:load phoneDisplay={site.phoneDisplay} phoneHref={site.phoneHref} compact={true} />
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-stone-ink">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl text-cream-50">Skip the peeling. Do it once.</h2>
        <p class="mt-2 text-cream-200/80">Free quotes across Salt Lake City and the surrounding valley.</p>
      </div>
      <a href={site.phoneHref} class="inline-flex shrink-0 items-center gap-2 rounded-full bg-sage-400 px-7 py-4 text-base font-semibold text-stone-ink transition-colors hover:bg-sage-300">
        Call {site.phoneDisplay}
      </a>
    </div>
  </section>
</Layout>
