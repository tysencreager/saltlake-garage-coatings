---
import { site } from "../data/site";

const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/epoxy-garage-floor-cost", label: "Pricing" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 bg-cream-50/90 backdrop-blur border-b border-cream-200"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${site.name} home`}>
      <img
        src="/SLlogo.png"
        alt=""
        width="40"
        height="40"
        class="h-10 w-10 rounded-lg"
      />
      <span class="leading-tight">
        <span class="block font-display text-base font-semibold text-stone-ink"
          >Salt Lake</span
        >
        <span class="block text-xs uppercase tracking-[0.18em] text-sand-600"
          >Garage Coatings</span
        >
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? "page" : undefined}
                class:list={[
                  "text-sm font-medium transition-colors hover:text-sage-600",
                  isActive(l.href) ? "text-sage-600" : "text-stone-soft",
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={site.phoneHref}
      class="group inline-flex items-center gap-2 rounded-full bg-sage-500 px-4 py-2.5 text-sm font-semibold text-cream-50 shadow-soft transition-colors hover:bg-sage-600"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-4 w-4"
        aria-hidden="true"
      >
        <path
          d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.21 2.2Z"
        ></path>
      </svg>
      <span class="hidden sm:inline">Call </span>{site.phoneDisplay}
    </a>
  </div>

  <!-- Mobile nav: lightweight, no JavaScript required. -->
  <nav aria-label="Primary mobile" class="md:hidden border-t border-cream-200">
    <ul class="mx-auto flex max-w-6xl items-center justify-center gap-6 px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "text-sm font-medium transition-colors hover:text-sage-600",
                isActive(l.href) ? "text-sage-600" : "text-stone-soft",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
