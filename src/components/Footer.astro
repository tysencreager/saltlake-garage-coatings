---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-20 bg-stone-ink text-cream-100">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <!-- Brand + call CTA -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <span
            class="grid h-9 w-9 place-items-center rounded-lg bg-sage-400 text-stone-ink font-display text-lg font-bold"
            aria-hidden="true">S</span
          >
          <span class="font-display text-lg font-semibold text-cream-50"
            >{site.name}</span
          >
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-cream-200/80">
          Premium epoxy and polyaspartic floor coatings for garages, patios, and
          commercial concrete across the Salt Lake Valley. Durable finishes and
          clean installs built to last through Utah winters.
        </p>
        <a
          href={site.phoneHref}
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-sage-400 px-5 py-3 text-sm font-semibold text-stone-ink transition-colors hover:bg-sage-300"
        >
          Call for a quote: {site.phoneDisplay}
        </a>
      </div>

      <!-- Pages -->
      <nav aria-label="Footer">
        <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-sand-300">
          Explore
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm text-cream-200/80">
          <li><a class="hover:text-cream-50" href="/">Home</a></li>
          <li><a class="hover:text-cream-50" href="/services">Services</a></li>
          <li><a class="hover:text-cream-50" href="/contact">Contact</a></li>
        </ul>
      </nav>

      <!-- Contact + service area -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-sand-300">
          Contact
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm text-cream-200/80">
          <li>
            <a class="hover:text-cream-50" href={site.phoneHref}
              >{site.phoneDisplay}</a
            >
          </li>
          <li>
            <a class="hover:text-cream-50" href={site.emailHref}
              >{site.emailDisplay}</a
            >
          </li>
          <li>{site.hours}</li>
          <li class="pt-1 text-cream-200/70">
            Serving {site.serviceAreas.join(", ")} & the greater Salt Lake Valley.
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-cream-100/10 pt-6 text-xs text-cream-200/60 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>
        In-home quotes across {site.city}, {site.regionName}.
      </p>
    </div>
  </div>
</footer>
